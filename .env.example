# ── Alpaca API ──────────────────────────────────────────────────────────────
# Get from: https://app.alpaca.markets/paper-trading/overview → API Keys
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# ── Risk Management ──────────────────────────────────────────────────────────
MAX_POSITIONS=8                  # max concurrent trades
MAX_POSITIONS_PER_SECTOR=2       # diversification limit per sector
RISK_PER_TRADE_PCT=0.02          # 2% of portfolio at risk per trade
STOP_LOSS_ATR_MULT=1.5           # initial stop = entry - 1.5×ATR
TAKE_PROFIT_ATR_MULT=2.5         # full TP  = entry + 2.5×ATR
MIN_RISK_REWARD=1.5              # skip trade if R:R < 1.5

# ── Trailing Stop ────────────────────────────────────────────────────────────
TRAILING_STOP_ENABLED=true
TRAILING_BREAKEVEN_ATR=1.0       # move stop to breakeven when up +1.0×ATR
TRAILING_LOCK_ATR=1.5            # lock +0.5×ATR profit when up +1.5×ATR

# ── Partial Profit ───────────────────────────────────────────────────────────
PARTIAL_PROFIT_ENABLED=true
PARTIAL_PROFIT_ATR=1.5           # sell 50% of position when up +1.5×ATR

# ── Strategy Thresholds ──────────────────────────────────────────────────────
RSI_BUY_MIN=28
RSI_BUY_MAX=45
RSI_SELL=68
STOCH_RSI_BUY_MAX=35             # Stochastic RSI < 35 = oversold confirmation
VOLUME_SURGE_FACTOR=1.2
MIN_STOCK_PRICE=10.0
MAX_HOLD_DAYS=7

# ── Market Regime Filter ─────────────────────────────────────────────────────
MARKET_REGIME_ENABLED=true       # only buy when SPY > 200 EMA
REGIME_SYMBOL=SPY
REGIME_EMA_PERIOD=200

# ── Scheduler ────────────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=300       # check every 5 minutes
PORT=8080                        # Railway health-check port
