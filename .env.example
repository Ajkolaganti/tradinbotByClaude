# ── Alpaca API ───────────────────────────────────────────────────────────────
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# ── LLM (chatbot + stock prediction) ─────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── Risk Management ───────────────────────────────────────────────────────────
MAX_POSITIONS=8
MAX_POSITIONS_PER_SECTOR=2
RISK_PER_TRADE_PCT=0.02
STOP_LOSS_ATR_MULT=1.5
TAKE_PROFIT_ATR_MULT=2.5
MIN_RISK_REWARD=1.5

# ── Trailing Stop ─────────────────────────────────────────────────────────────
TRAILING_STOP_ENABLED=true
TRAILING_BREAKEVEN_ATR=1.0
TRAILING_LOCK_ATR=1.5

# ── Partial Profit ────────────────────────────────────────────────────────────
PARTIAL_PROFIT_ENABLED=true
PARTIAL_PROFIT_ATR=1.5

# ── Strategy ──────────────────────────────────────────────────────────────────
RSI_BUY_MIN=28
RSI_BUY_MAX=45
RSI_SELL=68
STOCH_RSI_BUY_MAX=35
VOLUME_SURGE_FACTOR=1.2
MIN_STOCK_PRICE=10.0
MAX_HOLD_DAYS=7

# ── Short Selling (bear market) ───────────────────────────────────────────────
SHORT_SELLING_ENABLED=true
RSI_SHORT_MIN=60
RSI_SHORT_EXIT=35

# ── Market Regime ─────────────────────────────────────────────────────────────
MARKET_REGIME_ENABLED=true
REGIME_SYMBOL=SPY
REGIME_EMA_PERIOD=200

# ── Priority Filters ──────────────────────────────────────────────────────────
EARNINGS_BLACKOUT_DAYS=5          # P1: skip entry N days before earnings
EARNINGS_EXIT_DAYS=1              # P1: exit positions N days before earnings
RS_LOOKBACK_PERIOD=20             # P2: relative strength lookback
RS_TOP_N=25                       # P2: only trade top N RS-ranked stocks
SHORT_SELLING_ENABLED=true        # P3: short in bear markets
TIME_FILTER_ENABLED=true          # P4: only trade 10-12 and 14-15 ET
INTRADAY_CONFIRM_ENABLED=true     # P4: 15-min bar confirmation
SECTOR_ETF_CONFIRMATION=true      # P5: sector ETF above EMA20
HIST_WIN_RATE_MIN=50.0            # skip if historical RSI win rate < 50%

# ── Scheduler ─────────────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=300
PORT=8080
